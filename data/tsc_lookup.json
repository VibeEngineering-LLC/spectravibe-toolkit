{
  "$schema": "tsc_lookup_v1",
  "_meta": {
    "version": "v1.19.0",
    "created": "2026-06-03",
    "purpose": "True Coincidence Summing correction factors (TSCF) lookup table for HPGe-coaxial detectors. Populated in v1.19.0 Phase 4 (data-only, NOT yet wired to activity-computation pipeline). Pipeline wiring deferred to v1.19.1+.",
    "primary_index": "(nuclide, energy_keV, geometry, detector_class)",
    "tscf_definition": "TSCF = peak_area(monoenergetic_simulation) / peak_area(full_decay_with_CS). TSCF >= 1.0 for cascade emitters (summing-out reduces FEP).",
    "uncertainty_definition": "1-sigma absolute statistical uncertainty (MC counting statistics + decay-scheme propagation).",
    "sources": {
      "giubrone-2016": "Giubrone G., Ortiz J., Gallardo S., Martorell S., Bas M.C. (2016). Calculation of Coincidence Summing Correction Factors for an HPGe detector using GEANT4. J. Environ. Radioact. 158-159, 114-118. doi:10.1016/j.jenvrad.2016.04.008",
      "ordonez-2019-rpc": "Ordonez-Rodenas J., Gallardo Bermell S., Ortiz Moragon J., Martorell Alsina S.S. (2019). Coincidence summing correction factors for 238U and 232Th decay series using the Monte Carlo method. Radiation Physics and Chemistry 155, 244-247. doi:10.1016/j.radphyschem.2018.09.013"
    },
    "detector_baseline": "ORTEC GMX series 40% relative efficiency at 1.33 MeV, type-N HPGe coaxial, crystal volume 201 cm^3 (Giubrone 2016 Table 1). Same physical detector used by both Giubrone 2016 and Ordonez 2019 (UPV Valencia / LRA).",
    "extrapolation_warning": "All entries are detector-class HPGe-coaxial, ORTEC GMX40-specific. Other detector classes (NaI-Tl, LaBr3-Ce, CeBr3, CdZnTe, HPGe-BEGE) MUST NOT consume these values without dedicated calibration -- TSCF is nonlinear in eps_pp(E) and eps_T(E) which differ by 2-3x between HPGe coaxial and scintillators. See PLAN_v1_18_32_to_v1_19_0_TCS_INTEGRATION.md R5.4."
  },
  "detector_class_supported": [
    "HPGe-coaxial"
  ],
